#!/usr/bin/env bash

set -euo pipefail

SERVICE_NAME="${SERVICE_NAME:-berryboard.service}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
DEPLOY_DIR="$SCRIPT_DIR"

if [[ -d "$SCRIPT_DIR/current/.git" ]]; then
    DEPLOY_DIR="$SCRIPT_DIR/current"
fi

cd "$DEPLOY_DIR"

echo "Updating $(basename "$DEPLOY_DIR")..."
git pull --ff-only
DEPLOYED_COMMIT="$(git rev-parse --short HEAD)"
echo "Deployed commit: $DEPLOYED_COMMIT"

echo "Restarting $SERVICE_NAME..."
sudo systemctl restart "$SERVICE_NAME"

if systemctl is-active --quiet "$SERVICE_NAME"; then
    SERVICE_COMMAND="$(systemctl show "$SERVICE_NAME" --property=ExecStart --value)"

    if [[ "$SERVICE_COMMAND" != *"$DEPLOY_DIR"* ]]; then
        echo "$SERVICE_NAME is running a different project path:"
        echo "$SERVICE_COMMAND"
        exit 1
    fi

    echo "$SERVICE_NAME is running commit $DEPLOYED_COMMIT."
else
    echo "$SERVICE_NAME failed to start."
    sudo systemctl status "$SERVICE_NAME" --no-pager
    exit 1
fi